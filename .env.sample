# ---------------------------------------------------------------------------
# Core / ports
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3100
ADMIN_PORT=3101
STUDIO_PORT=5555
ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:5555

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_HUBNEGOCIOS_WEB_URL=http://localhost:3100
HUBNEGOCIOS_ADMIN_URL=http://localhost:3101
HUBNEGOCIOS_STUDIO_URL=http://localhost:5555

# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# Comma-separated emails that are auto-granted role=superadmin on first login.
HUBNEGOCIOS_SUPERADMIN_EMAILS=admin@hubnegocios.local
# Break-glass password login for local dev when Google OAuth isn't configured.
HUBNEGOCIOS_ADMIN_SEED_PASSWORD=change-me-local-admin-password

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=hubnegocios
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hubnegocios
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://hubnegocios:change-me@localhost:15432/hubnegocios?sslmode=disable
PRISMA_STUDIO_PORT=5555

# ---------------------------------------------------------------------------
# Auth: JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-long-random-value

# ---------------------------------------------------------------------------
# Auth: Google OAuth (UDP accounts)
# ---------------------------------------------------------------------------
GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Restrict which email domains may authenticate at all (defense in depth).
ADMIN_EMAIL_DOMAINS=udp.cl,mail.udp.cl

# ---------------------------------------------------------------------------
# Auth: Passkeys / WebAuthn
# ---------------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Hub Negocios UDP
WEBAUTHN_RP_ORIGINS=http://localhost:3100,http://localhost:3101

# ---------------------------------------------------------------------------
# Mail: "log" (local, no real sends) or "smtp"
# ---------------------------------------------------------------------------
MAIL_PROVIDER=log
MAIL_FROM=no-reply@hubnegocios.udp.cl
MAIL_REPLY_TO=contacto@hubnegocios.udp.cl
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_TLS_INSECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Storage: MinIO (S3-compatible)
# ---------------------------------------------------------------------------
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=hubnegocios-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_SIGNING_SECRET=change-me-long-random-value

# ---------------------------------------------------------------------------
# Redis (cache-only; API degrades gracefully if unavailable)
# ---------------------------------------------------------------------------
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379/0
